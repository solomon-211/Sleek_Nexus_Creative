# Used by `npm run build` (production). Overrides the localhost value in .env,
# so the live site sends form submissions to the deployed backend Worker.
# Not secret — it's a public address.
VITE_API_URL=https://api.sleeknexuscreative.com/api

# Show the team section on the About page of the live site.
VITE_SHOW_TEAM=true

# Admin dashboard (/admin): Supabase project address and its *publishable* key.
# Both are public by design; Row Level Security (backend/supabase/*.sql) is what
# keeps the data private to signed-in admins. Never put the secret key here.
VITE_SUPABASE_URL=https://pddtgxglrxlcvmnjevfe.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_8YfGP1xkX34YwzlIeBfRqg_tWQYwy98
